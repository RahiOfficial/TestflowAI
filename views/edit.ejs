<!DOCTYPE html>
<html lang="en" class="bg-slate-950 text-slate-100 min-h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Configure Test Cases - TestFlow</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="p-6 md:p-12 font-sans antialiased">

  <div class="max-w-5xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 pb-6 border-b border-slate-800">
      <div>
        <a href="/" class="text-xs text-indigo-400 font-semibold hover:underline flex items-center space-x-1 mb-2">
          <i class="fa-solid fa-arrow-left"></i>
          <span>Upload Another File</span>
        </a>
        <h1 class="text-3xl font-bold text-white">Review & Edit Test Parameters</h1>
        <p class="text-slate-400 text-sm mt-1">Found <%= testCases.length %> test case(s). Review expected parameters prior to PDF compilation.</p>
      </div>

      <button form="docForm" type="submit" class="mt-4 md:mt-0 py-3 px-6 rounded-xl bg-emerald-600 hover:bg-emerald-500 font-semibold text-white shadow-lg shadow-emerald-600/20 transition-all flex items-center space-x-2">
        <i class="fa-solid fa-file-pdf"></i>
        <span>Generate PDF Report</span>
      </button>
    </div>

    <!-- Form Cards -->
    <form id="docForm" action="/generate-doc" method="POST" class="space-y-6">
      <% testCases.forEach((tc, index) => { %>
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-sm hover:border-slate-700 transition-all">
          <div class="flex items-center space-x-3 mb-4">
            <span class="text-xs font-mono font-bold px-2.5 py-1 bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 rounded-md">
              TC-<%= String(index + 1).padStart(3, '0') %>
            </span>
            <input type="text" name="names" value="<%= tc.name %>" class="bg-transparent font-semibold text-slate-100 text-lg focus:outline-none border-b border-transparent hover:border-slate-700 focus:border-indigo-500 w-full px-1 transition-all">
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1">Input Preconditions</label>
              <textarea name="inputs" rows="2" placeholder="e.g. User age = 20, Status = Active" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 transition-all"></textarea>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1">Expected Result</label>
              <textarea name="expected" rows="2" placeholder="e.g. HTTP 200 OK Response" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 transition-all"></textarea>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1">Actual Verification</label>
              <textarea name="actual" rows="2" placeholder="e.g. Verified Pass (100% Match)" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 transition-all"></textarea>
            </div>
          </div>
        </div>
      <% }) %>
    </form>
  </div>

</body>
</html>